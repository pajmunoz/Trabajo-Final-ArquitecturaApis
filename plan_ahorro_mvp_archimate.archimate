      <child xsi:type="archimate:Note" id="id-node-mvp-note" font="1|Arial|10.0|2|COCOA|1|" fontColor="#5a5a5a" textAlignment="1">
        <bounds x="60" y="470" width="600" height="90"/>
        <content>MVP: simulación + varios planes + débito mensual (reintento simple) + progreso/historial + notificaciones.
Después: crédito con garantía, badges/bonos de tasa, comparador con gastos y cobranza acumulativa avanzada.</content>
      </child>
