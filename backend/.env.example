# Copiar a .env para correr los procesos fuera de Docker (npm run dev:*).
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
AUTH_PORT=3001
CORE_SIMULADO_PORT=4000
DATABASE_URL=postgres://billetera:billetera@localhost:5432/billetera
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Cadena de MongoDB Atlas del Core simulado (la de Carina). Nunca se versiona.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=core_bancario_db
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ISSUER=billetera-ahorro-auth
JWT_AUDIENCE=billetera-ahorro-api
CORE_MODO=http
CORE_BASE_URL=http://localhost:4000
CORE_TIMEOUT_MS=2000
CB_UMBRAL_ERROR_PORCENTAJE=50
CB_VENTANA_MS=10000
CB_RESET_MS=30000
RETRY_INTENTOS=3
RETRY_BASE_MS=1000
BATCH_HORA_CORTE=06:00
# Solo para demostrar resiliencia:
CORE_SIMULADO_LATENCIA_MS=0
CORE_SIMULADO_FALLA_PORCENTAJE=0
