{
  "name": "billetera-ahorro-backend",
  "version": "1.0.0",
  "description": "Backend de la Billetera de Ahorro: API REST, autenticación JWT, batch de débitos y adaptador del Core bancario (monolito modular por capas).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev:api": "tsx watch src/apps/api.ts",
    "dev:auth": "tsx watch src/apps/auth.ts",
    "dev:batch": "tsx watch src/apps/batch.ts",
    "dev:core-adapter": "tsx watch src/apps/core-adapter.ts",
    "dev:core-simulado": "tsx watch src/apps/core-simulado.ts",
    "start:api": "node dist/apps/api.js",
    "start:auth": "node dist/apps/auth.js",
    "start:batch": "node dist/apps/batch.js",
    "start:core-adapter": "node dist/apps/core-adapter.js",
    "start:core-simulado": "node dist/apps/core-simulado.js",
    "batch:corte": "tsx src/apps/batch.ts --corte",
    "claves": "node scripts/generar-claves.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
