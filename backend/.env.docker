# Variables para docker-compose (valores de desarrollo, sin secretos).
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
DATABASE_URL=postgres://billetera:billetera@postgres:5432/billetera
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
